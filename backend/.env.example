# Keep provider secrets on the backend only.
QWEN_API_KEY=
QWEN_MODEL=qwen3.8-max
QWEN_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
JIMENG_ACCESS_KEY_ID=
JIMENG_SECRET_ACCESS_KEY=
XIAOYUNQUE_WATERMARK=true
# 通义万相视频生成(推荐替代小云雀)。留空时回退用 QWEN_API_KEY。
WAN_VIDEO_API_KEY=
WAN_VIDEO_MODEL=wan3.0-video
WAN_VIDEO_BASE_URL=
WAN_VIDEO_RATIO=9:16
WAN_VIDEO_RESOLUTION=720P
# compose: stable local character video with speech/subtitles; provider: Wan native video.
VIDEO_RENDER_STRATEGY=provider
HAPPYHORSE_MODEL=happyhorse-1.1-r2v
HAPPYHORSE_BASE_URL=
HAPPYHORSE_RESOLUTION=1080P
HAPPYHORSE_TIMEOUT=1200
HAPPYHORSE_POLL_INTERVAL=10
IMAGE_API_KEY=
IMAGE_MODEL=qwen-image-2.0
IMAGE_BASE_URL=
IMAGE_TIMEOUT=180
# 抖音官方热门视频榜单。需在开放平台申请相应数据权限。
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=
# 可选：直接提供有效 client_token；为空时使用上面的应用凭据获取。
DOUYIN_ACCESS_TOKEN=
DOUYIN_HOT_API_URL=https://open.douyin.com/data/extern/billboard/hot_video/
PLATFORM_HTTP_TIMEOUT=15
# Or start with CREATOROS_ENV_FILE=/absolute/path/to/existing/.env
# CREATOROS_DATA_DIR=/absolute/path/to/runtime
