# Gemini API key,从 https://aistudio.google.com/apikey 获取
GEMINI_API_KEY=

# Gemini API key(用 wolfai 中转时填中转给你的 key)
GEMINI_API_KEY=

# 中转地址(wolfai)。SDK 会自动拼 /v1beta/models/...:generateContent
# 形如 https://你的wolfai域名(不要带 /v1beta 后缀)
GEMINI_BASE_URL=

# 默认模型
GEMINI_MODEL=gemini-3.1-pro-preview

# 单次内联视频大小上限(MB)。中转一般只代理 generateContent,
# 不支持 Files API 上传,故视频走内联 base64。短视频通常 <20MB 够用。
INLINE_VIDEO_MAX_MB=20

# 自动压缩:视频超过该大小(MB)就先用 ffmpeg 压缩再发。
# 实测 wolfai 对含视频大请求有体积瓶颈,压到 1-2MB 最稳。
AUTO_COMPRESS_OVER_MB=3
COMPRESS_WIDTH=720
COMPRESS_CRF=28

# Qwen 模型配置(用于逆向 prompt)
# 阿里云 DashScope API Key,从 https://dashscope.console.aliyun.com/ 获取
QWEN_API_KEY=
# 默认模型
QWEN_MODEL=qwen-vl-max-latest
# API 地址(默认阿里云 DashScope)
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 即梦视频生成(火山引擎)
JIMENG_ACCESS_KEY_ID=
JIMENG_SECRET_ACCESS_KEY=
# 生成视频轮询间隔(秒)
JIMENG_POLL_INTERVAL=10
